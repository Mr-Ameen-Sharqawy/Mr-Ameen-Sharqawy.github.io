rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.uid == '4gDzRFRfacN8SpB9zv6iigSmQGD3';
    }

    function signedIn() {
      return request.auth != null;
    }

    match /studentAccess/{studentUid} {
      allow get: if (signedIn() && request.auth.uid == studentUid) || isTeacher();
      allow list: if isTeacher();
      allow create, delete: if isTeacher();

      allow update: if isTeacher();

      allow update: if signedIn()
        && request.auth.uid == studentUid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['devices'])
        && request.resource.data.devices.keys()
          .hasAll(resource.data.devices.keys())
        && request.resource.data.devices.size()
          <= resource.data.maxDevices;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
