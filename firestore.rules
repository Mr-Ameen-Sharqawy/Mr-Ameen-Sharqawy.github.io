rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /studentAccess/{studentUid} {
      allow get: if signedIn() && request.auth.uid == studentUid;
      allow list, create, delete: if false;

      allow update: if signedIn()
        && request.auth.uid == studentUid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['devices'])
        && request.resource.data.devices.keys()
          .hasAll(resource.data.devices.keys())
        && request.resource.data.devices.size()
          <= resource.data.maxDevices;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
